+# ── Cover letter (one full page) ─────────────────────────────────────────
+
+def _letter_html(text: str, size: float, header: dict) -> str:
+    import html as H
+    paras = [p.strip() for p in re.split(r"\n\s*\n", text.strip()) if p.strip()]
+    body = "".join(f"<p>{H.escape(p).replace(chr(10), '<br>')}</p>" for p in paras)
+    contact = " &nbsp;|&nbsp; ".join(H.escape(x) for x in header["contact"] if x)
+    return f"""<!DOCTYPE html><html><head><meta charset="utf-8"><style>
+@page {{ size: letter; margin: 0; }}
+* {{ margin:0; padding:0; box-sizing:border-box; }}
+html, body {{ width:8.5in; height:11in; }}
+body {{ font-family:'Times New Roman',Georgia,serif; color:#111; padding:0.9in 1in; font-size:{size}pt; line-height:1.4; }}
+.name {{ font-size:{size*1.9}pt; font-weight:700; letter-spacing:.5px; }}
+.contact {{ font-size:{size*0.85}pt; margin:4px 0 {size*1.1}pt; padding-bottom:{size*0.6}pt; border-bottom:1px solid #111; }}
+.date {{ margin-bottom:{size*1.1}pt; }}
+p {{ margin-bottom:{size*1.0}pt; text-align:justify; }}
+</style></head><body>
+<div class="name">{H.escape(header['name'])}</div><div class="contact">{contact}</div>
+<div class="date">{header['date']}</div>{body}</body></html>"""
+
+
+def render_cover_letter_pdf(text: str, output_path: Path) -> Path:
+    """A business letter on exactly one page, font size chosen so the text fills it."""
+    import datetime
+    from playwright.sync_api import sync_playwright
+    from applypilot.config import load_profile
+    try:
+        pers = load_profile().get("personal", {})
+    except Exception:
+        pers = {}
+    where = ", ".join(x for x in (pers.get("city"), pers.get("province_state")) if x)
+    header = {"name": pers.get("full_name") or "", "date": datetime.date.today().strftime("%B %-d, %Y"),
+              "contact": [where, pers.get("email"), pers.get("phone")]}
+    # Standard letter form: salutation, body, "Sincerely," and the full name (replace any bare-name sign-off).
+    lines = text.strip().splitlines()
+    while lines and (not lines[-1].strip() or re.fullmatch(r"(sincerely|best|regards|thank you)?,?\s*", lines[-1].strip(), re.I)
+                     or (pers.get("full_name") or "\0").lower().startswith(lines[-1].strip().lower().rstrip(","))):
+        lines.pop()
+    text = "\n".join(lines).rstrip() + f"\n\nSincerely,\n{pers.get('full_name') or ''}"
+    with sync_playwright() as p:
+        browser = p.chromium.launch()
+        page = browser.new_page(viewport={"width": 816, "height": 1056})
+        lo, hi, best = 9.0, 11.5, 9.0  # normal size; only shrinks if the text is long
+        for _ in range(8):  # binary search the largest size that still fits one page
+            mid = (lo + hi) / 2
+            page.set_content(_letter_html(text, mid, header))
+            fits = page.evaluate("document.body.scrollHeight <= document.documentElement.clientHeight + 1")
+            if fits:
+                best, lo = mid, mid
+            else:
+                hi = mid
+        page.set_content(_letter_html(text, best, header))
+        page.pdf(path=str(output_path), format="Letter", margin={"top": "0", "right": "0", "bottom": "0", "left": "0"},
+                 print_background=True, page_ranges="1")
+        browser.close()
+    return Path(output_path)
+
+
